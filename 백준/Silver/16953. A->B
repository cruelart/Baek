#include <iostream>
#include <string>

using namespace std;

int main()
{
	int A, B;
	cin >> A >> B;

	int count_num = 1;

	while (true)
	{
		if (B == A)
		{
			break;
		}
		
		if (B < A)
		{
			count_num = -1;
			break;
		}
		if (B > A && B % 2 == 0)
		{
			B /= 2;
			count_num++;
			continue;
		}

		string B_str = to_string(B);

		if (B_str.back() == '1')
		{
			count_num++;
			B_str.pop_back();
			B = stoi(B_str);
			continue;
		}

		count_num = -1;
		break;
	}

	cout << count_num;

	return 0;
}
