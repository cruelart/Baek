#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void change_vec(vector<vector<int>>& _graph, pair<int,int> _start_index)
{
	int r = _start_index.first;
	int c = _start_index.second;

	for (int i = r; i < r + 3; i++)
	{
		for (int j = c; j < c + 3; j++)
		{
			if (_graph[i][j] == 1)
			{
				_graph[i][j] = 0;
			}
			else
			{
				_graph[i][j] = 1;
			}
		}
	}
}

int main()
{
	int N, M;
	cin >> N >> M;

	vector<vector<int>> graph(N, vector<int>(M));
	vector<vector<int>> result(N, vector<int>(M));

	for (int r = 0; r < N; r++)
	{
		string str;
		cin >> str;

		for (int c = 0; c < str.length(); c++)
		{
			graph[r][c] = str[c] - '0';
		}
	}

	for (int r = 0; r < N; r++)
	{
		string str;
		cin >> str;

		for (int c = 0; c < str.length(); c++)
		{
			result[r][c] = str[c] - '0';
		}
	}


	if (N < 3 || M < 3)
	{
		for (int r = 0; r < N; r++)
		{
			for (int c = 0; c < M; c++)
			{
				if (graph[r][c] != result[r][c])
				{
					cout << -1;
					return 0;
				}
			}
		}
		cout << 0;
		return 0;
	}

	int change_num = 0;

	for (int r = 0; r <= N - 3; r++)
	{
		for (int c = 0; c <= M - 3; c++)
		{
			if (graph[r][c] != result[r][c])
			{
				change_vec(graph, { r,c });
				change_num++;
			}
		}
	}

	for (int r = 0; r < N; r++)
	{
		for (int c = 0; c < M; c++)
		{
			if (graph[r][c] != result[r][c])
			{
				cout << -1;
				return 0;
			}
		}
	}

	cout << change_num;

	return 0;
}
