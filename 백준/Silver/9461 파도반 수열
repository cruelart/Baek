#include <iostream>
#include <vector>

using namespace std;

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int T;
	cin >> T; // 테스트 실행 횟수

	for (int t = 0; t < T; t++)
	{
		int N;
		cin >> N;

		vector<long long> dp_table(N + 1);

		for (int n = 1; n < N + 1; n++)
		{
			if (n <= 3)
			{
				dp_table[n] = 1;
			}
			else if (n <= 5)
			{
				dp_table[n] = 2;
			}
			else
			{
				dp_table[n] = dp_table[n - 1] + dp_table[n - 5];
			}
		}

		cout << dp_table[N] << '\n';
	}

	return 0;
}

// N => 1일때 1
// N => 2일때 1
