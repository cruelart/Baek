#include <iostream>
#include <queue>
#include <vector>
#include <algorithm>

using namespace std;

int main()
{
	int N;
	cin >> N;

	vector<pair<long long, long long>> end_start(N);

	for (int n = 0; n < N; n++)
	{
		cin >> end_start[n].second >> end_start[n].first;
	}

	sort(end_start.begin(), end_start.end()); //오름차순으로 정렬

	priority_queue<long long, vector<long long>, greater<>> end_queue;

	end_queue.push(end_start[0].first);


	for (int n = 1; n < N; n++)
	{
		long long end_time = end_queue.top();

		if (end_start[n].second >= end_time)
		{
			end_time = end_start[n].first;
			end_queue.pop();
			end_queue.push(end_time);
		}
		else // 
		{
			end_queue.push(end_start[n].first);
		}
	}

	cout << end_queue.size();

	return 0;
}

