#include <iostream>
#include <vector>
#include <queue>
#include <tuple>

using namespace std;

int BFS(vector<vector<vector<int>>>& _graph, vector<vector<vector<int>>>& _time, queue<tuple<int, int, int>>& _bfs_queue, int _count)
{
	int count = 0; // 익은 토마토를 센 횟수
	int max_count = 0;

	while (!_bfs_queue.empty())
	{
		auto present_index = _bfs_queue.front();
		count++;
		_bfs_queue.pop();

		int x = get<0>(present_index);
		int y = get<1>(present_index);
		int z = get<2>(present_index);

		//상자 위, 상 좌 우 하 , 상자 아래 순서
		if (z - 1 >= 0) // 상자 위
		{
			if (_graph[z - 1][y][x] == 0)
			{
				_bfs_queue.emplace(x, y, z - 1);
				_graph[z - 1][y][x] = 1;
				_time[z - 1][y][x] = _time[z][y][x] + 1;
				max_count = _time[z][y][x] + 1;
			}
		}
		if (y - 1 >= 0) // 상
		{
			if (_graph[z][y - 1][x] == 0)
			{
				_bfs_queue.emplace(x, y - 1, z);
				_graph[z][y - 1][x] = 1;
				_time[z][y - 1][x] = _time[z][y][x] + 1;
				max_count = _time[z][y][x] + 1;
			}
		}
		if (x - 1 >= 0) // 좌
		{
			if (_graph[z][y][x - 1] == 0)
			{
				_bfs_queue.emplace(x - 1, y, z);
				_graph[z][y][x - 1] = 1;
				_time[z][y][x - 1] = _time[z][y][x] + 1;
				max_count = _time[z][y][x] + 1;
			}
		}
		if (x + 1 < _graph[0][0].size()) // 우
		{
			if (_graph[z][y][x + 1] == 0)
			{
				_bfs_queue.emplace(x + 1, y, z);
				_graph[z][y][x + 1] = 1;
				_time[z][y][x + 1] = _time[z][y][x] + 1;
				max_count = _time[z][y][x] + 1;
			}
		}
		if (y + 1 < _graph[0].size())//하
		{
			if (_graph[z][y + 1][x] == 0)
			{
				_bfs_queue.emplace(x, y + 1, z);
				_graph[z][y + 1][x] = 1;
				_time[z][y + 1][x] = _time[z][y][x] + 1;
				max_count = _time[z][y][x] + 1;
			}
		}
		if (z + 1 < _graph.size()) // 상자 아래
		{
			if (_graph[z + 1][y][x] == 0)
			{
				_bfs_queue.emplace(x, y, z + 1);
				_graph[z + 1][y][x] = 1;
				_time[z + 1][y][x] = _time[z][y][x] + 1;
				max_count = _time[z][y][x] + 1;
			}
		}
	}
	if (count != _count)
	{
		return -1;
	}

	return max_count;
}

int main()
