#include <iostream>
#include <vector>

using namespace std;

int main()
{
	int arr[42] = {};
	int count = 0;
	for (int i = 0; i < 10; i++)
	{
		int A, B;
		B = 42;
		cin >> A;
		arr[A % B]++;
	}

	for (int j = 0; j < 42; j++)
	{
		if (arr[j] != 0)
		{
			count++;
		}
	}

	cout << count;

	return 0;
}
