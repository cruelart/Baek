#include <iostream>
#include <vector>
#include <limits>
#include <queue>

using namespace std;

void dijkstra(vector<vector<pair<int,int>>>& _graph, vector<int>& _dist, int _start_index)
{
	priority_queue<pair<int, int>, vector<pair<int,int>> ,greater<pair<int,int>>> dij_queue; // 거리, 인덱스
	_dist[_start_index] = 0;
	dij_queue.push({ _dist[_start_index], _start_index });

	while (!dij_queue.empty())
	{
		int present_index = dij_queue.top().second;
		int present_dist = dij_queue.top().first;

		dij_queue.pop();

		if (present_dist > _dist[present_index])
		{
			continue;
		}

		for (int index = 0; index < _graph[present_index].size(); index++)
		{
			int next_index = _graph[present_index][index].first;
			int value = _graph[present_index][index].second;

			if (_dist[next_index] > _dist[present_index] + value)
			{
				_dist[next_index] = _dist[present_index] + value;
				dij_queue.push({ _dist[next_index], next_index });
			}
		}
	}
}

int main()
{
	int N;
	cin >> N; // 마을 수, 학생 수 통합

	int M;
	cin >> M; // 단방향 도로 갯수

	int X;
	cin >> X; // 도착 마을(나한텐 시작점)

	int INF = numeric_limits<int>::max();

	vector<vector<pair<int,int>>> graph(N + 1);
	vector<vector<pair<int,int>>> reverse_graph(N + 1);
	vector<int> dist(N + 1, INF);
	vector<int> reverse_dist(N + 1, INF);

	for (int m = 0; m < M; m++)
	{
		int start_index, end_index, value;
		cin >> start_index >> end_index >> value;

		graph[start_index].push_back({ end_index,value });
		reverse_graph[end_index].push_back({ start_index,value });
	}

	dijkstra(graph, dist, X);
	dijkstra(reverse_graph, reverse_dist, X);

	int max_dist = 0;

	for (int i = 1; i < dist.size(); i++)
	{
		max_dist = max(max_dist, dist[i] + reverse_dist[i]);
	}

	cout << max_dist;

	return 0;
}
