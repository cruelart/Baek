#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int main()
{
	string str1;
	string str2;

	cin >> str1 >> str2;

	bool isSame = false;

	for (int index = str2.length() - 1; index >= 0; index--)
	{
		if (str1 == str2)
		{
			isSame = true;
			break;
		}

		if (str2[index] == 'A')
		{
			// A만 지우기
			str2.erase(index, 1);
		}
		else if (str2[index] == 'B')
		{
			str2.erase(index, 1); // B지우고

			reverse(str2.begin(), str2.end());
		}
		else
		{

		}
	}

	if (isSame)
	{
		cout << 1;
		return 0;
	}
	cout << 0;


	return 0;
}
