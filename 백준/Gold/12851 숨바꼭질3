#include <iostream>
#include <vector>
#include <queue>
#include <tuple>

using namespace std;

int dijkstra(int _N, int _K)
{
	int count = 0;

	vector<bool> isVisit(100001, false);

	priority_queue<pair<int,int>, vector<pair<int,int>>, greater<>> dij_queue; // 거리, 인덱스번호
	dij_queue.push({ 0,_N });

	while (!dij_queue.empty())
	{
		int present_index = dij_queue.top().second;
		int present_value = dij_queue.top().first;

		isVisit[present_index] = true;

		dij_queue.pop();

		if (present_index != _K) // 수빈이가 온 곳이 동생이 있는 곳이 아니라면
		{
			if (present_index - 1 >= 0 && !isVisit[present_index - 1])
			{
				dij_queue.push({ present_value + 1, present_index - 1 });
			}
			if (present_index + 1 <= 100000 && !isVisit[present_index + 1])
			{
				dij_queue.push({ present_value + 1 , present_index + 1 });
			}
			if (present_index * 2 <= 100000 && !isVisit[present_index * 2])
			{
				dij_queue.push({ present_value + 0 ,present_index * 2 });
			}
			continue;
		}
		return present_value;
	}
	return -1;

}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int N, K;
	cin >> N >> K;

	cout << dijkstra(N, K);

	return 0;
}
