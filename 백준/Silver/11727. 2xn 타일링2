#include <iostream>
#include <vector>

using namespace std;

int main()
{
	int n;
	cin >> n;

	vector<int> dp_table(max(n + 1,3), 0);
	dp_table[1] = 1;
	dp_table[2] = dp_table[1] + 2;

	for (int i = 3; i <= n; i++)
	{
		dp_table[i] = (dp_table[i - 1] + dp_table[i - 2] * 2) % 10007;
	}

	cout << dp_table[n];

	return 0;
}
