#include <iostream>
#include <vector>

using namespace std;

int main()
{
	int T;
	cin >> T;

	for (int t = 0; t < T; t++)
	{
		int n;
		cin >> n;

		vector<int> dp_table(n + 1, 1);
		if (n == 1)
		{
			cout << 1 << '\n';
			continue;
		}

		if (n == 2)
		{
			cout << 2 << '\n';
			continue;
		}

		if (n == 3)
		{
			cout << 4 << '\n';
			continue;
		}

		dp_table[1] = 1;
		dp_table[2] = 2;
		dp_table[3] = 4;

		for (int i = 4; i <= n; i++)
		{
			dp_table[i] = dp_table[i - 3] + dp_table[i - 2] + dp_table[i - 1];
		}

		cout << dp_table[n] << '\n';
	}

	return 0;
}
