#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main()
{
	int N; // 추의 갯수
	cin >> N;

	int max_num = 0;

	vector<int> base_num(N);

	for (int i = 0; i < N; i++)
	{
		cin >> base_num[i];
		max_num += base_num[i];
	}

	sort(base_num.begin(), base_num.end());

	if (base_num[0] != 1)
	{
		cout << 1;
		return 0;
	}

	int check_num = 1; // 그게아니면 현재 1까지는 체크 (1 ~ 1)

	for (int i = 1; i < base_num.size(); i++)
	{
		if (base_num[i] > check_num + 1)
		{
			cout << check_num + 1;
			return 0;
		}

		check_num += base_num[i];
	}

	cout << check_num + 1;

	return 0;
}

