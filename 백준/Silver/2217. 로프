#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main()
{
	int N;
	cin >> N;

	vector<int> rope(N);

	for (int n = 0; n < N; n++)
	{
		cin >> rope[n];
	}

	sort(rope.begin(), rope.end());

	if (rope.empty())
	{
		return 0;
	}
	int max_weight = rope[0] * N;

	for (int n = 1; n < N; n++)
	{
		max_weight = max(max_weight, rope[n] * (N - n));
	}

	cout << max_weight;

	return 0;
}
