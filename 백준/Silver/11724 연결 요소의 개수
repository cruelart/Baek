#include <iostream>
#include <vector>
#include <stack>

using namespace std;

void dfs(vector<vector<int>>& _graph, vector<bool>& _isVisit, int _start_index)
{
	stack<int> dfs_stack;
	dfs_stack.push(_start_index);
	_isVisit[_start_index] = true;

	while (!dfs_stack.empty())
	{
		int present_index = dfs_stack.top();
		dfs_stack.pop();

		for (int i = 0; i < _graph[present_index].size(); i++)
		{
			int next_num = _graph[present_index][i];

			if (!_isVisit[next_num])
			{
				dfs_stack.push(next_num);
				_isVisit[next_num] = true;
			}
		}
	}
}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int N, M; //정점의 개수, 간선의 개수
	cin >> N >> M;

	vector<vector<int>> graph(N + 1);
	vector<bool> isVisit(N + 1, false);

	for (int m = 0; m < M; m++)
	{
		int start, end;
		cin >> start >> end;

		graph[start].push_back(end);
		graph[end].push_back(start);
	}

	int count = 0;
	for (int i = 1; i < isVisit.size(); i++)
	{
		if (!isVisit[i])
		{
			dfs(graph, isVisit, i);
			count++;
		}
	}

	cout << count;

	return 0;
}
