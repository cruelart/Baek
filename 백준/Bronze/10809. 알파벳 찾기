#include <iostream>

using namespace std;

int main()
{
	string S;
	cin >> S;
	int arr[26] = {}; // 알파벳
	fill(arr, arr + 26, -1);
	
	for (int i = 0; i < S.size(); i++)
	{
		if (arr[S[i] - 'a'] == -1)
		{
			arr[S[i] - 'a'] = i;
		}

	}

	for (int j = 0; j < 26; j++)
	{
		cout << arr[j] << ' ';
	}

	return 0;
}
