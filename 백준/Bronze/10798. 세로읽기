#include <iostream>
#include <string>

using namespace std;

int main()
{
	string arr_str[5]; // 문자를 담을 배열 선언
	string result;

	for (int i = 0; i < 5; i++)
	{
		string str;
		cin >> str;
		arr_str[i] = str;
	}

	for (int i = 0; i < 15; i++)
	{
		for (int j = 0; j < 5; j++)
		{
			if (arr_str[j].size() > i)
			{
				result += arr_str[j][i];
			}
		}
	}

	cout << result;
}
