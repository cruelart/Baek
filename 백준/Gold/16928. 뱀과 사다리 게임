#include <iostream>
#include <vector>
#include <queue>
#include <limits>

using namespace std;

void BFS(vector<int>& _graph , vector<int>& _dist)
{
	queue<int> bfs_queue;
	bfs_queue.push(1);

	while (!bfs_queue.empty())
	{
		auto present_index = bfs_queue.front();
		bfs_queue.pop();

		for (int i = 1; i < 7; i++)
		{
			if (present_index + i <= 100)
			{
				if (_graph[present_index + i] != 0)
				{
					if (_dist[_graph[present_index + i]] > _dist[present_index] + 1)
					{
						bfs_queue.push(_graph[present_index + i]);
						_dist[_graph[present_index + i]] = _dist[present_index] + 1;
					}
				}
				else
				{
					if (_dist[present_index + i] > _dist[present_index] + 1)
					{
						bfs_queue.push(present_index + i);
						_dist[present_index + i] = _dist[present_index] + 1;
					}
				}
			}
		}
	}
}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int N, M; // 사다리의 수, 뱀의 수
	cin >> N >> M;

	int INF = numeric_limits<int>::max();

	vector<int> graph(101, 0);
	vector<int> dist(101, INF);
	dist[1] = 0;

	//사다리
	for (int n = 0; n < N; n++)
	{
		int start_index, end_index;
		cin >> start_index >> end_index;
		graph[start_index] = end_index;
	}
	//뱀
	for (int m = 0; m < M; m++)
	{
		int start_index, end_index;
		cin >> start_index >> end_index;
		graph[start_index] = end_index;
	}

	BFS(graph,dist);

	cout << dist[100];

	return 0;
}
