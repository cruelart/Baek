#include <iostream>
#include <vector>
#include <queue>

using namespace std;

int BFS(vector<vector<pair<int, int>>>& _graph, queue<pair<int, int>>& _bfs_queue, int _count)
{
	int max_count = 0;
	int count = _bfs_queue.size();
	while (!_bfs_queue.empty())
	{
		pair<int, int> present_index = _bfs_queue.front(); // 현재 좌표
		_bfs_queue.pop();
		
		int x = present_index.first;
		int y = present_index.second;

		// 상 좌 우 하 순서대로
		if (y - 1 >= 0)// 좌표가 토마토 상자안에 있다면 (상)
		{
			if (_graph[y - 1][x].first == 0)
			{
				_bfs_queue.emplace(x, y - 1);

				_graph[y - 1][x].first = 1;
				_graph[y - 1][x].second = _graph[y][x].second + 1;

				max_count = _graph[y - 1][x].second;
				count++;
			}
		}
		if (x - 1 >= 0)// 좌표가 토마토 상자안에 있다면 (좌)
		{
			if (_graph[y][x - 1].first == 0)
			{
				_bfs_queue.emplace(x - 1, y);

				_graph[y ][x - 1].first = 1;
				_graph[y ][x - 1].second = _graph[y][x].second + 1;

				max_count = _graph[y][x - 1].second;
				count++;
			}
		}
		if (x + 1 < _graph[0].size())// 좌표가 토마토 상자안에 있다면 (우)
		{
			if (_graph[y][x + 1].first == 0)
			{
				_bfs_queue.emplace(x + 1, y);

				_graph[y][x + 1].first = 1;
				_graph[y][x + 1].second = _graph[y][x].second + 1;

				max_count = _graph[y][x + 1].second;
				count++;
			}
		}
		if (y + 1 < _graph.size())// 좌표가 토마토 상자안에 있다면 (하)
		{
			if (_graph[y + 1][x].first == 0)
			{
				_bfs_queue.emplace(x, y + 1);

				_graph[y + 1][x].first = 1;
				_graph[y + 1][x].second = _graph[y][x].second + 1;

				max_count = _graph[y + 1][x].second;
				count++;
			
			}
		}

	}

	if (count != _count) // -1을 제외한 모든 정점을 돌지 않았다면
	{
		return -1;
	}
	return max_count;
}

int main()
{
	int M, N; // 가로길이, 세로길이
	cin >> M >> N;

	vector<vector<pair<int,int>>> graph(N, vector<pair<int,int>>(M, {-2, -1})); // 익엇는가 여부와, 익는데 걸린 시간
	queue<pair<int, int>> bfs_queue; 

	int count = M * N;

	for (int i = 0; i < N; i++)
	{
		for (int j = 0; j < M; j++)
		{
			int isGood; // 익었는가? -1 => 비어있음 0 -> 안익음 1 -> 익음
			cin >> isGood;

			graph[i][j] = make_pair(isGood, 0); // y , x 순으로
			if (isGood == 1)
			{
				bfs_queue.emplace(j, i);
			}
			else if (isGood == -1)
			{
				count--;
			}
		}

	}

	cout << BFS(graph, bfs_queue, count);

	return 0;
}
