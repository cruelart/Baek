#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void dfs(vector<int>& _graph, vector<int>& _save_arr, bool* _isVisit, int _N, int _M, int _depth)
{
	if (_depth == _M)
	{
		for (int i = 0; i < _save_arr.size(); i++)
		{
			cout << _save_arr[i] << ' ';
		}
		cout << '\n';
		return;
	}

	for(int num : _graph)
	{
		if (_isVisit[num])
		{
			continue;
		}

		_isVisit[num] = true;
		_save_arr[_depth] = num;
		dfs(_graph, _save_arr, _isVisit, _N, _M, _depth + 1);
		_isVisit[num] = false;
	}
}

int main()
{
	int N, M;
	cin >> N >> M;

	vector<int> graph(N);
	vector<int> save_arr(M);
	bool isVisit[10001] = {};

	for (int n = 0; n < N; n++)
	{
		cin >> graph[n];
	}

	sort(graph.begin(), graph.end());

	int depth = 0;
	dfs(graph, save_arr, isVisit, N, M, depth);

	return 0;
}
