#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main()
{
	int N;
	cin >> N;

	int alphab[26] = {};
	int alphab_change[26] = {};
	int result = 0;

	vector<pair<int, int>> alpha_size; // 크기, 알파벳


	for (int n = 0; n < N; n++)
	{
		string str;
		cin >> str;

		reverse(str.begin(), str.end());

		int p = 1;
		for (int index = 0; index < str.length(); index++)
		{
			alphab[str[index] - 'A'] += p;
			p *= 10;
		}
	}

	for (int i = 0; i < 26; i++)
	{
		if (alphab[i] != 0)
		{
			alpha_size.push_back({ alphab[i], i });
		}
	}

	sort(alpha_size.begin(), alpha_size.end(), greater<>()); // 큰 순서대로 정렬

	int num = 9;

	for (int i = 0; i < alpha_size.size(); i++)
	{
		result += num * alpha_size[i].first;
		num--;
	}

	cout << result;

	return 0;
}
