#include <iostream>
#include <vector>
#include <limits>
#include <queue>

using namespace std;

void bfs(vector<vector<pair<int, long long>>>& _graph, vector<long long>& _dist, int _start_index, long long _INF)
{
	vector<bool> isVisit(_dist.size(), false); // 방문 확인 재방문 방지용
	queue<int> bfs_queue;
	bfs_queue.push(_start_index);

	while (!bfs_queue.empty())
	{
		int present_index = bfs_queue.front();
		bfs_queue.pop();
		isVisit[present_index] = true;

		for (int i = 0; i < _graph[present_index].size(); i++)
		{
			int start = present_index;
			int end = _graph[present_index][i].first;
			long long distance = _graph[present_index][i].second;

			if (!isVisit[_graph[present_index][i].first])
			{
				bfs_queue.push(_graph[present_index][i].first);
			}

			if (_dist[start] != _INF)
			{
				if (_dist[end] > _dist[start] + _graph[present_index][i].second)
				{
					_dist[end] = _dist[start] + _graph[present_index][i].second;
				}
			}
		}
	}
}

void examine_function(vector<long long>& _dist, int a, int b, long long c)
{
	_dist[b] = _dist[a] - c;
}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int N, M; // 정점의 수, 간선의 수
	int a, b;
	long long c;

	cin >> N >> M >> a >> b >> c;

	long long INF = std::numeric_limits<long long>::max();

	vector<vector<pair<int, long long>>> graph(N+1); // 인접 리스트
	vector<long long> dist(N+1, INF); // 정점별 거리 저장배열
	dist[1] = 0;

	vector<long long> testDist(N + 1, INF);

	for (int i = 0; i < M; i++)
	{
		int start, end, distance;
		distance = 1; // 거리는 1로 고정

		cin >> start >> end;

		graph[start].emplace_back(end, distance); // 양방향이 아닌 방향그래프이므로 end는 추가 x
		if (i == M - 1 && a != b)
		{
			graph[a].emplace_back(b, 0);
		}
	}

	bfs(graph, dist, 1, INF);

	if (dist[N] == INF)
	{
		cout << "x";
		return 0;
	}

	if (dist[a] == INF || dist[b] == INF) // 어처피 타켓정점과 연결돼있지 않은 정점이기때문에 생략
	{
		cout << dist[N];
		return 0;
	}

	//음의 간선이 영향을 미칠 경우

	examine_function(dist, a, b, c);
	bfs(graph, dist, b, INF);

	testDist = dist;

	examine_function(testDist, a, b, c);
	bfs(graph, testDist, b, INF);

	//dist의 타켓지점에 변화가 있거나 자기자신 타임머신이면 무한사이클을 지니고 있다. 
	if (dist[N] != testDist[N] || dist[b] > dist[a] - c)
	{
		cout << "-inf";
		return 0;
	}

	//그 마저도 아니면 최단거리가 존재하니 출력
	cout << dist[N];

	return 0;
}
