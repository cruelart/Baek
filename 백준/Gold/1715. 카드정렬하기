#include <iostream>
#include <vector>
#include <queue>

using namespace std;

int main()
{
	int N; // N <= 100000
	cin >> N;

	if (N < 1)
	{
		return 0;
	}

	priority_queue<int, vector<int>, greater<int> > card_num;

	for (int n = 0; n < N; n++)
	{
		int num;
		cin >> num;
		card_num.push(num);
	}

	if (N == 1)
	{
		cout << 0;
		return 0;
	}

	long long result = 0;

	while(card_num.size() != 1)
	{
		int compare_num1 = card_num.top();
		card_num.pop();

		int compare_num2 = card_num.top();
		card_num.pop();

		card_num.push(compare_num1 + compare_num2);

		result += (compare_num1 + compare_num2);
	}

	cout << result;

	return 0;
}

