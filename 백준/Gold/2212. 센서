#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main()
{
	int N; //센서의 갯수
	cin >> N;

	int K;
	cin >> K; // 집중국의 갯수
	
	vector<int> sensor_pos(N);

	for (int n = 0; n < N; n++)
	{
		cin >> sensor_pos[n];
	}

	sort(sensor_pos.begin(), sensor_pos.end()); // 작은 순서대로 정렬

	vector<int> sensor_dist(N - 1); // 센서끼리의 거리 

	for (int n = 0; n < N - 1; n++)
	{
		sensor_dist[n] = sensor_pos[n + 1] - sensor_pos[n];
	}
	
	sort(sensor_dist.begin(), sensor_dist.end());

	int result = 0;

	for (int i = 0; i < (N -1) - (K - 1); i++)
	{
		result += sensor_dist[i];
	}
	
	cout << result;

	return 0;
}

