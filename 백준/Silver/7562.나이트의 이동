#include <iostream>
#include <vector>
#include <queue>

using namespace std;

int BFS(pair<int,int> _start_index, pair<int,int> _end_index, vector<vector<int>>& _dist)
{
	queue<pair<int, int>> bfs_queue;
	bfs_queue.push(_start_index);

	while (!bfs_queue.empty())
	{
		int p_x = bfs_queue.front().first;
		int p_y = bfs_queue.front().second;

		bfs_queue.pop();

		if (p_x == _end_index.first && p_y == _end_index.second)
		{
			return _dist[p_y][p_x];
		}

		if (p_x - 1 >= 0 && p_y - 2 >= 0 )
		{
			if (p_x - 1 < _dist.size() && p_y - 2 < _dist.size())
			{
				if (_dist[p_y - 2][p_x - 1] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x - 1, p_y - 2);
					_dist[p_y - 2][p_x - 1] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x - 2 >= 0 && p_y - 1 >= 0)
		{
			if (p_x - 2 < _dist.size() && p_y - 1 < _dist.size())
			{
				if (_dist[p_y - 1][p_x - 2] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x - 2, p_y - 1);
					_dist[p_y - 1][p_x - 2] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x - 2 >= 0 && p_y + 1 >= 0)
		{
			if (p_x - 2 < _dist.size() && p_y + 1 < _dist.size())
			{
				if (_dist[p_y + 1][p_x - 2] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x - 2, p_y + 1);
					_dist[p_y + 1][p_x - 2] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x - 1 >= 0 && p_y + 2 >= 0)
		{
			if (p_x - 1 < _dist.size() && p_y + 2 < _dist.size())
			{
				if (_dist[p_y + 2][p_x - 1] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x - 1, p_y + 2);
					_dist[p_y + 2][p_x - 1] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x + 1 >= 0 && p_y + 2 >= 0)
		{
			if (p_x + 1 < _dist.size() && p_y + 2 < _dist.size())
			{
				if (_dist[p_y + 2][p_x + 1] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x + 1, p_y + 2);
					_dist[p_y + 2][p_x + 1] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x + 2 >= 0 && p_y + 1 >= 0)
		{
			if (p_x + 2 < _dist.size() && p_y + 1 < _dist.size())
			{
				if (_dist[p_y + 1][p_x + 2] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x + 2, p_y + 1);
					_dist[p_y + 1][p_x + 2] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x + 2 >= 0 && p_y - 1 >= 0)
		{
			if (p_x + 2 < _dist.size() && p_y - 1 < _dist.size())
			{
				if (_dist[p_y - 1][p_x + 2] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x + 2, p_y - 1);
					_dist[p_y - 1][p_x + 2] = _dist[p_y][p_x] + 1;
				}
			}
		}

		if (p_x + 1 >= 0 && p_y - 2 >= 0)
		{
			if (p_x + 1 < _dist.size() && p_y - 2 < _dist.size())
			{
				if (_dist[p_y - 2][p_x + 1] == -1) // 방문한 적이 없다면
				{
					bfs_queue.emplace(p_x + 1, p_y - 2);
					_dist[p_y - 2][p_x + 1] = _dist[p_y][p_x] + 1;
				}
			}
		}
	}

	return -1;
}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int test_num; // 테스트 할 횟수
	cin >> test_num;

	vector<int> result;


	for (int i = 0; i < test_num; i++)
	{ 
		int I; // 체스판 한 변의 길이
		cin >> I;

		vector<vector<int>> dist(I, vector<int>(I, -1));

		pair<int, int> start;
		cin >> start.first >> start.second;

		dist[start.second][start.first] = 0;

		pair<int, int> end;
		cin >> end.first >> end.second;

		result.push_back(BFS(start, end, dist));
	}

	for (int i = 0; i < result.size(); i++)
	{
		cout << result[i] << '\n';
	}

	return 0;
}
