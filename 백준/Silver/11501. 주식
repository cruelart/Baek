#include <iostream>
#include <vector>
#include <queue>

using namespace std;

void exe_baek()
{
	int N;
	cin >> N;

	vector<int> day_price(N, -1);
	priority_queue<pair<int, int>> high_price; // 가격 날짜

	long long total_cost = 0;

	for (int n = 0; n < N; n++)
	{
		cin >> day_price[n];
		high_price.push({ day_price[n], n });
	}

	vector<int> buy_item;

	for (int n = 0; n < N; n++)
	{
		while (high_price.top().second < n)
		{
			high_price.pop();
		}

		int max_price = high_price.top().first;

		if (day_price[n] < max_price) // 비싸게 팔 수 있다면 사두기
		{
			buy_item.push_back(day_price[n]);
		}

		else if(day_price[n] >= max_price)// 팔아야 되는 고점 시기다 팔고 Run
		{
			for (int i = 0; i < buy_item.size(); i++)
			{
				total_cost += (day_price[n] - buy_item[i]);
			}
			buy_item.clear();

		}
		else // 아니면 존버
		{

		}
	}

	cout << total_cost << '\n';
}

int main()
{
	int T;
	cin >> T;

	for (int t = 0; t < T; t++)
	{
		exe_baek();
	}

	return 0;
}
