#include <iostream>

using namespace std;

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int arr[9];
	pair<int, int> max_num = { -1,-1 }; // 자연수, 위치
	for (int i = 0; i < 9; i++)
	{
		int num;
		cin >> num;
		arr[i] = num;
	}

	for (int j = 0; j < 9; j++)
	{
		if (max_num.first < arr[j])
		{
			max_num = { arr[j], j+1 };
		}
	}

	cout << max_num.first << '\n';
	cout << max_num.second << '\n';

	return 0;
}
