#include <iostream>
#include <vector>

using namespace std;

vector<vector<vector<int>>> dp_table(20 + 1, vector<vector<int>>(20 + 1, vector<int>(20 + 1)));

void w_dp()
{
	//dp 테이블 작성

	for (int i = 0; i <= 20; i++)
	{
		for (int j = 0; j <= 20; j++)
		{
			for (int z = 0; z <= 20; z++)
			{
				if (i == 0 || j == 0 || z == 0)
				{
					dp_table[i][j][z] = 1;
				}
				else if (i < j && j < z)
				{
					dp_table[i][j][z] = dp_table[i][j][z - 1] + dp_table[i][j - 1][z - 1] - dp_table[i][j - 1][z];
				}
				else
				{
					dp_table[i][j][z] = dp_table[i - 1][j][z] + dp_table[i - 1][j - 1][z] + dp_table[i - 1][j][z - 1] - dp_table[i - 1][j - 1][z - 1];
				}
			}
		}
	}

}

int main()
{
	w_dp();

	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	while (true)
	{
		int a, b, c;
		cin >> a >> b >> c;

		if (a == -1 && b == -1 && c == -1) // 입력 중단
		{
			return 0;
		}

		if (a <= 0 || b <= 0 || c <= 0)
		{
			cout << "w(" << a << ", " << b << ", " << c << ") = " << 1 << '\n';
			continue;
		}

		if (a > 20 || b > 20 || c > 20)
		{
			cout << "w(" << a << ", " << b << ", " << c << ") = " << dp_table[20][20][20] << '\n';
			continue;
		}

		cout << "w(" << a << ", " << b << ", " << c << ") = " << dp_table[a][b][c] << '\n';
	}

	return 0;
}
