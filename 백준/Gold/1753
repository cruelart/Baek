#include <iostream>
#include <vector>
#include <limits>
#include <queue>

using namespace std;

void dijkstra(vector<vector<pair<int,int>>>& _graph, vector<int>& _dist, int _start_index, int _INF)
{
	priority_queue<pair<int, int>, vector<pair<int,int>>, greater<>> dijkstra_queue; // 가중치,도착 정점 순서
	dijkstra_queue.emplace(_dist[_start_index], _start_index);

	while (!dijkstra_queue.empty())
	{
		int present_index = dijkstra_queue.top().second;
		int present_index_distance = dijkstra_queue.top().first;

		dijkstra_queue.pop();

		if (_dist[present_index] < present_index_distance)
		{
			continue; // 이미 최단 경로이므로 생략
		}

		for (int i = 0; i < _graph[present_index].size(); i++)
		{
			int end_index = _graph[present_index][i].first;
			int value = _graph[present_index][i].second;

			if (_dist[present_index] != _INF && _dist[end_index] > _dist[present_index] + value)
			{
				_dist[end_index] = _dist[present_index] + value;
				dijkstra_queue.emplace(_dist[end_index], end_index);
			}
		}
	}
}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int V, E; // 정점의 개수, 간선의 개수
	int start_num; // 시작 정점 번호

	int INF = std::numeric_limits<int>::max();

	cin >> V >> E;
	cin >> start_num;

	vector<vector<pair<int, int>>> graph(V + 1); // 도착정점, 가중치 순서
	vector<int> dist(V + 1, INF);
	dist[start_num] = 0; // 시작지점 0으로 초기화

	for (int i = 0; i < E; i++)
	{
		int u, v, w; //시작정점, 끝 정점, 가중치
		cin >> u >> v >> w;

		graph[u].emplace_back(v,w);
	}

	dijkstra(graph, dist, start_num, INF);

	for (int i = 1; i < dist.size(); i++)
	{
		if (dist[i] == INF)
		{
			cout << "INF" << '\n';
			continue;
		}
		cout << dist[i] << '\n';
	}

	return 0;
}
